<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/addSuperheroe.css">
    <title>Agregar superheroes</title>
</head>
<body>
    <h1>Agregar Superhéroe</h1>

    <% if (typeof error !== 'undefined' && error) { %>
        <div style="color: red;">
            <%= error %>
        </div>
    <% } %>
    <div class="form-container">
        <form action="/api/agregar" method="POST">
            <label for="nombreSuperHeroe">Nombre del Superhéroe:</label><br>
            <input type="text" id="nombreSuperHeroe" name="nombreSuperHeroe" required><br><br>
        
            <label for="nombreReal">Nombre Real:</label><br>
            <input type="text" id="nombreReal" name="nombreReal" required><br><br>
        
            <label for="edad">Edad:</label><br>
            <input type="number" id="edad" name="edad" required min="0"><br><br>
    
            <label for="debilidad">debilidad:</label><br>
            <input type="text" id="debilidad" name="debilidad" ><br><br>
        
            <label for="poderes">Poderes (separados por coma):</label><br>
            <input type="text" id="poderes" name="poderes" required><br><br>
        
            <label for="aliados">Aliados (separados por coma):</label><br>
            <input type="text" id="aliados" name="aliados"><br><br>
        
            <label for="enemigos">Enemigos (separados por coma):</label><br>
            <input type="text" id="enemigos" name="enemigos"><br><br>
        
            <label for="creador">Creador:</label><br>
            <input type="text" id="creador" name="creador" required><br><br>
    
            <button type="submit">Guardar</button>
        </form>
    </div>  
</body>
</html>